ory", "pk": 1, "fields": {"name": "Карнизы"}}, {"model": "item.category", "pk": 2, "fields": {"name": "Фурнитура"}}, {"model": "item.category", "pk": 3, "fields": {"name": "Шторы"}}, {"model": "item.item", "pk": 4, "fields": {"category": 1, "name": "Симпл", "description": "Профильный карниз \"Симпл\" — универсальная система для легких и средних штор, сочетающая минималистичный дизайн и надежную конструкцию.\r\n\r\nПреимущества:\r\n\r\nСовременный лаконичный профиль\r\nПодходит для тюля и стандартных штор\r\nЛегкий и быстрый монтаж\r\nПлавное скольжение штор\r\nДолговечность и устойчивость к деформации\r\nОтличное решение для квартир и офисов", "price": "650.00", "unit": "m", "image": "item_images/690f1527b301a8d2f451ce3104379eba-simple-400x350_cCv7tZX_7kUGXvW_3sHonC9.jpg", "is_sold": false, "created_by": 5, "created_at": "2026-02-21T18:34:57.218Z", "aliases": "simple,basic,профиль"}}, {"model": "item.item", "pk": 5, "fields": {"category": 1, "name": "Усиленный симпл", "description": "Профильный карниз \"Усиленный Симпл\" — усиленная версия базовой модели, предназначенная для более тяжелых и многослойных штор.\r\n\r\nПреимущества:\r\n\r\nУсиленная конструкция профиля\r\nВыдерживает повышенную нагрузку\r\nМинимальный прогиб при большой длине\r\nПодходит для плотных портьер\r\nНадежная фиксация креплений\r\nЭстетичный внешний вид", "price": "850.00", "unit": "m", "image": "item_images/690f1527b301a8d2f451ce3104379eba-st-2500-400x350_WgietuJ_mS6QoCx.jpg", "is_sold": false, "created_by": 5, "created_at": "2026-02-21T18:35:39.624Z", "aliases": "усиленный Simple,reinforced simple"}}, {"model": "item.item", "pk": 6, "fields": {"category": 1, "name": "СТ-1100", "description": "Профильный карниз \"СТ-1100\" — профессиональная система для тяжелых тканей и широких оконных проемов.\r\n\r\nПреимущества:\r\n\r\nМаксимальная несущая способность\r\nВысокая жесткость профиля\r\nПодходит для больших проемов\r\nИдеален для тяжелых и декоративных штор\r\nДолговечная и стабильная конструкция\r\nПодходит для жилых и коммерческих помещений", "price": "600.00", "unit": "m", "image": "item_images/690f1527b301a8d2f451ce3104379eba-ct1100_EEEUHeI_nh4qEst.1-400x350.jpg", "is_sold": false, "created_by": 5, "created_at": "2026-02-21T18:36:31.143Z", "aliases": "ст,ст11,ст1100,ст110,st1100,st11,st,st110,ст 11, st 11, ст 1100, ст 110, st 1100, st 110"}}, {"model": "item.item", "pk": 7, "fields": {"category": 2, "name": "Крючок для штор", "description": "Надёжный и удобный элемент крепления штор к карнизу. Обеспечивает лёгкое скольжение ткани и простоту установки. Подходит для большинства типов шторных лент и карнизных систем.", "price": "5.00", "unit": "pcs", "image": "item_images/orig-2.webp", "is_sold": false, "created_by": 5, "created_at": "2026-02-23T09:40:35.395Z", "aliases": "крючки, крючок, петелька, петли,"}}, {"model": "item.item", "pk": 8, "fields": {"category": 2, "name": "Глайдер для карниза \"Усиленный Симпл\"", "description": "Прочный глайдер, разработанный специально для системы \"Усиленный Симпл\". Обеспечивает плавное и бесшумное движение даже тяжёлых и плотных штор. Отличается повышенной износостойкостью и долговечностью.", "price": "5.00", "unit": "pcs", "image": "item_images/images-2.jpeg", "is_sold": false, "created_by": 5, "created_at": "2026-02-23T09:59:03.689Z", "aliases": "бегунки, бегунок, глайдер"}}, {"model": "item.item", "pk": 9, "fields": {"category": 2, "name": "Глайдер для карниза \"Симпл\"", "description": "Стандартный глайдер для системы \"Симпл\", гарантирующий лёгкое и ровное скольжение штор. Идеально подходит для тюля и штор средней плотности. Прост в установке и эксплуатации.", "price": "5.00", "unit": "pcs", "image": "item_images/images-2-2.jpeg", "is_sold": false, "created_by": 5, "created_at": "2026-02-23T10:00:09.575Z", "aliases": "бегунки, бегунок, глайдер"}}, {"model": "item.item", "pk": 10, "fields": {"category": 2, "name": "Глайдер для карниза \"СТ-1100\"", "description": "Усиленный глайдер для профессиональной системы \"СТ-1100\". Рассчитан на повышенные нагрузки и работу с тяжёлыми тканями. Обеспечивает стабильное и плавное движение по профилю.", "price": "5.00", "unit": "pcs", "image": "item_images/ca7029e540e101e88cb8220d246bd802-gl-ks-400x350-2.jpg", "is_sold": false, "created_by": 5, "created_at": "2026-02-23T10:00:59.673Z", "aliases": "бегунки, бегунок, глайдер"}}, {"model": "item.item", "pk": 11, "fields": {"category": 2, "name": "Кронштейн", "description": "Надёжный крепёжный элемент для установки карнизной системы к стене или потолку. Обеспечивает устойчивость конструкции и безопасную эксплуатацию. Подходит для различных типов профильных карнизов.", "price": "150.00", "unit": "pcs", "image": "item_images/ca7029e540e101e88cb8220d246bd802-kronsht-400x350-2.jpg", "is_sold": false, "created_by": 5, "created_at": "2026-02-23T10:02:20.855Z", "aliases": "кранштейн"}}, {"model": "item.favorite", "pk": 47, "fields": {"user": 2, "item": 5, "added_at": "2026-02-24T11:43:29.405Z"}}, {"model": "item.favorite", "pk": 50, "fields": {"user": 6, "item": 4, "added_at": "2026-03-03T13:08:31.109Z"}}, {"model": "item.favorite", "pk": 52, "fields": {"user": 5, "item": 4, "added_at": "2026-03-12T13:01:23.952Z"}}, {"model": "item.favorite", "pk": 53, "fields": {"user": 7, "item": 4, "added_at": "2026-03-12T13:03:15.025Z"}}, {"model": "item.favorite", "pk": 55, "fields": {"user": 7, "item": 6, "added_at": "2026-03-12T13:03:17.463Z"}}]
